{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "besc-website-publication-v1"
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "news.schema.json"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  }
}
