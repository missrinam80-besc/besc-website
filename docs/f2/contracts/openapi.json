  "components": {
    "securitySchemes": {
      "SiteKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-BESC-Publication-Key"
      },
      "ViewerJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "request_id"
        ],
        "properties": {
          "code": {
            "enum": [
              "bad_request",
              "unauthenticated",
              "forbidden",
              "not_found",
              "rate_limited",
              "unavailable"
            ]
          },
          "request_id": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
