# Server-only configuration. Never paste real values into Git or chat.
BESC_WEBSITE_STAGING_ENABLED=false
BESC_WEBSITE_URL=https://website-dev.belgianstreamerscommunity.be
BESC_CC_URL=https://cc-dev.belgianstreamerscommunity.be
BESC_PUBLICATION_KEY=
BESC_AUTH_URL=
BESC_AUTH_PUBLISHABLE_KEY=

# Afzonderlijke F4-creatorketen; geen nieuwe toegang of publicatie door deze flag alleen.
BESC_CREATOR_PLATFORM_ENABLED=false

# Private aanvragen: afzonderlijk inschakelen na vrijgave.
BESC_PLATFORM_INTAKE_ENABLED=false

# Partner- en esportsprofielen: afzonderlijk vrijgeven.
BESC_PARTNER_PLATFORM_ENABLED=false

# Vacatures en sollicitaties: standaard uit.
BESC_VACANCY_PLATFORM_ENABLED=false

# Scoped partner representation; disabled until a separate release.
BESC_PARTNER_DELEGATION_ENABLED=false

# Separate information-page and reviewed temporary legacy mapping gates.
BESC_SITE_PAGES_ENABLED=false
BESC_SITE_REDIRECTS_ENABLED=false
BESC_LEGACY_SOURCE_HOST=www.belgianstreamerscommunity.be

# Authenticated general contact through the private CC intake; default closed.
BESC_GENERAL_CONTACT_ENABLED=false

# F6: deployment target is explicit; NODE_ENV=production also applies to DEV Docker.
BESC_DEPLOYMENT_ENV=dev
# Authenticated preview only; existing site-page and staging guards remain required.
BESC_RELEASE_PREVIEW_ENABLED=false
# Leave empty on DEV. Production values must match the corresponding URL exactly.
BESC_APPROVED_PRODUCTION_WEBSITE_ORIGIN=
BESC_APPROVED_PRODUCTION_CC_ORIGIN=
