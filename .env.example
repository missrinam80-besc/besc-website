# Server-only configuration. Never paste real values into Git or chat.
BESC_WEBSITE_STAGING_ENABLED=false
BESC_WEBSITE_URL=https://website-dev.belgianstreamerscommunity.be
BESC_CC_URL=https://cc-dev.belgianstreamerscommunity.be
BESC_PUBLICATION_KEY=
BESC_AUTH_URL=
BESC_AUTH_PUBLISHABLE_KEY=

# Afzonderlijke F4-creatorketen; geen nieuwe toegang of publicatie door deze flag alleen.
BESC_CREATOR_PLATFORM_ENABLED=false

# Private aanvragen: afzonderlijk inschakelen na vrijgave.
BESC_PLATFORM_INTAKE_ENABLED=false

# Partner- en esportsprofielen: afzonderlijk vrijgeven.
BESC_PARTNER_PLATFORM_ENABLED=false

# Vacatures en sollicitaties: standaard uit.
BESC_VACANCY_PLATFORM_ENABLED=false
